#!/usr/bin/env bash
# caw-agent one-line installer.
#   curl -fsS https://agent.noxcaw.com/install | bash
#   curl -fsS https://agent.noxcaw.com/install | bash -s -- v0.1.1
# Windows PowerShell: irm https://agent.noxcaw.com/install.txt | iex
# Env: CAW_TAG  CAW_GITHUB  PREFIX  BIN_DIR  GH_TOKEN  CAW_GITHUB_TOKEN  NO_COLOR  CAW_NO_PATH
set -euo pipefail

REPO="${CAW_GITHUB:-noxrick91/caw-agent-hub}"
PREFIX="${PREFIX:-${HOME}/.caw-agent}"
BIN_DIR="${BIN_DIR:-${PREFIX}/bin}"
TAG="${CAW_TAG:-latest}"

if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
  C0="" C1="" C2="" C3="" CD=""
else
  C0=$'\033[0m'
  C1=$'\033[1m'
  C2=$'\033[32m'
  C3=$'\033[31m'
  CD=$'\033[2m'
fi

step() { printf '%s▸%s %s\n' "$CD" "$C0" "$1"; }
ok() { printf '%s✓%s %s\n' "$C2" "$C0" "$1"; }
die() { printf '%s✗%s %s\n' "$C3" "$C0" "$1" >&2; exit 1; }

# Write ~/.caw-agent/env, hook login-shell rc files, and source PATH now.
# curl | bash cannot update the already-open parent shell; new terminals will.
ensure_shell_path() {
  if [ -n "${CAW_NO_PATH:-}" ]; then
    return 0
  fi
  local env_file rc added=""
  env_file="${PREFIX}/env"
  mkdir -p "${PREFIX}"
  cat >"${env_file}" <<EOF
# Generated by the caw-agent installer.
case ":\${PATH}:" in
  *":${BIN_DIR}:"*) ;;
  *) export PATH="${BIN_DIR}:\${PATH}" ;;
esac
EOF

  # Current process (and the rest of this script).
  set +eu
  # shellcheck disable=SC1090
  . "${env_file}"
  set -eu

  while IFS= read -r rc; do
    [ -n "${rc}" ] || continue
    mkdir -p "$(dirname "${rc}")"
    if [ -f "${rc}" ] && grep -F -q ">>> caw-agent >>>" "${rc}"; then
      continue
    fi
    [ -f "${rc}" ] || : >"${rc}"
    if [[ "${rc}" == *"/config.fish" ]]; then
      {
        printf '\n# >>> caw-agent >>>\n'
        printf 'if test -d "%s"\n  fish_add_path "%s"\nend\n' "${BIN_DIR}" "${BIN_DIR}"
        printf '# <<< caw-agent <<<\n'
      } >>"${rc}"
    else
      {
        printf '\n# >>> caw-agent >>>\n'
        printf '[ -f "%s" ] && . "%s"\n' "${env_file}" "${env_file}"
        printf '# <<< caw-agent <<<\n'
      } >>"${rc}"
    fi
    added="${added}${added:+ }${rc}"
  done <<EOF
$(caw_rc_targets)
EOF

  # Source the matching rc only in an interactive matching shell (not curl | bash).
  set +eu
  if [ -t 0 ]; then
    if [ -n "${ZSH_VERSION:-}" ] && [ -f "${HOME}/.zshrc" ]; then
      # shellcheck disable=SC1090
      . "${HOME}/.zshrc"
    elif [ -n "${BASH_VERSION:-}" ] && [ -f "${HOME}/.bashrc" ]; then
      # shellcheck disable=SC1090
      . "${HOME}/.bashrc"
    fi
  fi
  set -eu

  if [ -n "${added}" ]; then
    ok "PATH hook → ${added}"
  else
    ok "PATH hook already present"
  fi
  case ":${PATH}:" in
    *":${BIN_DIR}:"*) ;;
    *) export PATH="${BIN_DIR}:${PATH}" ;;
  esac
}

caw_rc_targets() {
  local primary f
  case "$(basename "${SHELL:-}")" in
    zsh) primary="${HOME}/.zshrc" ;;
    fish) primary="${HOME}/.config/fish/config.fish" ;;
    bash)
      if [ "$(uname -s 2>/dev/null)" = "Darwin" ]; then
        primary="${HOME}/.bash_profile"
      else
        primary="${HOME}/.bashrc"
      fi
      ;;
    *) primary="${HOME}/.profile" ;;
  esac
  {
    printf '%s\n' "${primary}"
    for f in "${HOME}/.zshrc" "${HOME}/.zprofile" "${HOME}/.bashrc" "${HOME}/.bash_profile" "${HOME}/.profile"; do
      [ -f "${f}" ] && printf '%s\n' "${f}"
    done
  } | awk 'NF && !seen[$0]++'
}

if [ $# -gt 1 ]; then
  die "Usage: install [latest|now|vX.Y.Z]"
fi
if [ $# -eq 1 ]; then
  TAG="$1"
fi
case "${TAG}" in
  latest | now) TAG="latest" ;;
  v*) ;;
  [0-9]*) TAG="v${TAG}" ;;
  *) die "invalid version \`${TAG}\` (want latest|now|vX.Y.Z)" ;;
esac

command -v curl >/dev/null 2>&1 || die "missing curl"
command -v uname >/dev/null 2>&1 || die "missing uname"

printf '\n%s caw-agent installer%s\n\n' "$C1" "$C0"

step "Detecting platform…"
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
bin_name="caw-agent"
fallback_asset=""
case "${os}-${arch}" in
  linux-x86_64 | linux-amd64)
    asset="caw-agent-x86_64-unknown-linux-gnu"
    ;;
  linux-aarch64 | linux-arm64)
    asset="caw-agent-aarch64-unknown-linux-gnu"
    ;;
  darwin-arm64)
    asset="caw-agent-aarch64-apple-darwin"
    ;;
  darwin-x86_64)
    asset="caw-agent-x86_64-apple-darwin"
    ;;
  mingw*-aarch64 | mingw*-arm64 | msys*-aarch64 | msys*-arm64 | cygwin*-aarch64 | cygwin*-arm64 | windows*-aarch64 | windows*-arm64)
    asset="caw-agent-aarch64-pc-windows-msvc.exe"
    fallback_asset="caw-agent-x86_64-pc-windows-msvc.exe"
    bin_name="caw-agent.exe"
    ;;
  mingw* | msys* | cygwin* | windows*)
    asset="caw-agent-x86_64-pc-windows-msvc.exe"
    bin_name="caw-agent.exe"
    ;;
  *)
    die "unsupported platform ${os}-${arch}. See https://github.com/${REPO}/releases"
    ;;
esac
ok "Detected ${os}/${arch} → ${asset}"

dest="${BIN_DIR}/${bin_name}"
if [ "${TAG}" = "latest" ]; then
  base="https://github.com/${REPO}/releases/latest/download"
else
  base="https://github.com/${REPO}/releases/download/${TAG}"
fi

auth=()
token="${CAW_GITHUB_TOKEN:-${GH_TOKEN:-}}"
if [ -n "${token}" ]; then
  auth=(-H "Authorization: Bearer ${token}")
fi

download() {
  local url="$1" out="$2" label="$3"
  step "${label}"
  local code
  code="$(curl -L --progress-bar -A "caw-agent-installer" "${auth[@]}" -o "${out}" -w "%{http_code}" "${url}" || true)"
  if [ "${code}" = "404" ]; then
    die "not found: ${url}
  no public Release yet — https://github.com/${REPO}/releases"
  fi
  if [ "${code}" = "403" ] || [ "${code}" = "429" ]; then
    die "GitHub HTTP ${code}. Set GH_TOKEN or CAW_GITHUB_TOKEN and retry."
  fi
  if [ "${code}" != "200" ]; then
    die "HTTP ${code} for ${url}"
  fi
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    die "missing sha256sum/shasum"
  fi
}

tmp="$(mktemp -d)"
cleanup() { rm -rf "${tmp}"; }
trap cleanup EXIT

mkdir -p "${BIN_DIR}"
download "${base}/SHA256SUMS" "${tmp}/SHA256SUMS" "Fetching SHA256SUMS…"
# Release workflows on Windows may write CRLF; $NF would then be "name\\r".
tr -d '\r' <"${tmp}/SHA256SUMS" >"${tmp}/SHA256SUMS.lf"
mv "${tmp}/SHA256SUMS.lf" "${tmp}/SHA256SUMS"

sum_for() {
  awk -v a="$1" '$NF==a || $NF=="*"a {print $1; exit}' "${tmp}/SHA256SUMS"
}

expect="$(sum_for "${asset}")"
if [ -z "${expect}" ] && [ -n "${fallback_asset}" ]; then
  step "No ${asset} in this release — using ${fallback_asset}"
  asset="${fallback_asset}"
  expect="$(sum_for "${asset}")"
fi
[ -n "${expect}" ] || die "SHA256SUMS has no entry for ${asset}"
download "${base}/${asset}" "${tmp}/${asset}" "Downloading ${asset}…"
got="$(sha256_of "${tmp}/${asset}")"
if [ "${expect}" != "${got}" ]; then
  die "SHA256 mismatch for ${asset}
  expected ${expect}
  got      ${got}"
fi
ok "Checksum verified"

had_dest=0
if [ -e "${dest}" ]; then
  had_dest=1
  cp -f "${dest}" "${dest}.bak" 2>/dev/null || true
fi
chmod +x "${tmp}/${asset}"
mv "${tmp}/${asset}" "${dest}"
ok "Installed ${dest}"

ver="$("${dest}" --version 2>/dev/null || true)"
rollback_binary() {
  rm -f "${dest}"
  if [ "${had_dest}" = "1" ] && [ -e "${dest}.bak" ]; then
    mv -f "${dest}.bak" "${dest}"
  fi
}
if [ -z "${ver}" ]; then
  rollback_binary
  die "downloaded binary did not run: ${dest} --version"
fi
if [ -n "${ver}" ] && [ "${TAG}" != "latest" ]; then
  expect_ver="${TAG#v}"
  ver_num="${ver##* }"
  ver_num="${ver_num#v}"
  if [ "${ver_num}" != "${expect_ver}" ]; then
    rollback_binary
    die "${dest} --version is \`${ver}\`, expected ${expect_ver}"
  fi
fi

ensure_shell_path

printf '\n%sInstallation complete.%s\n' "$C1" "$C0"
if [ -n "${ver}" ]; then
  printf '  version  %s\n' "${ver}"
fi
printf '  binary   %s\n' "${dest}"
printf '  sha256   %s\n' "${got}"
printf '  PATH     %s\n' "${BIN_DIR}"
if [ ! -t 0 ]; then
  printf '\n%sThis install ran via a pipe, so your current shell is unchanged.%s\n' "$CD" "$C0"
  printf '  source %s/env\n' "${PREFIX}"
  printf '  or open a new terminal.\n'
fi

printf '\n  caw-agent --help\n  caw-agent upgrade --check\n\n'

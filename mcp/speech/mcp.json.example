{
  "mcpServers": {
    "speech": {
      "command": "python",
      "args": ["mcp/speech/server.py"],
      "env": {
        "SPEECH_BACKEND": "auto",
        "SPEECH_MCP_LOG": ".caw-agent/speech-mcp.log"
      },
      "description": "Speech-to-text (Whisper local or OpenAI-compatible API)"
    }
  }
}
